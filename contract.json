{
  "_comment": "Competition rules that do not depend on the target model. Target-specific settings live in target.json.",
  "num_speculative_tokens": 3,
  "max_model_len": 16384,
  "gpu_memory_utilization": 0.9,
  "max_num_seqs": 4,
  "seed": 0,
  "repeats": 1,
  "startup_timeout_s": 1800,
  "request_timeout_s": 1200,
  "size_cap": {"max_params": 1500000000, "max_file_bytes": 3000000000},
  "score": {
    "weights": {"acceptance": 0.5, "memory": 0.25, "tpot": 0.25},
    "cap": 1.5,
    "acceptance_gate": 0.9
  },
  "allowed_files": ["config.json", "spec.json", "metadata.json", "generation_config.json",
                    "README.md", "*.safetensors", "model.safetensors.index.json"],
  "forbidden_config_keys": ["auto_map"],
  "spec_keys": ["method"],
  "tensor_prefixes": {"mtp": ["mtp."]}
}
